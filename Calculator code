
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>10K Girlie 🎀</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #f8f3f5;
      color: #292329;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
    }
    .calculator {
      background: white;
      width: 90%;
      max-width: 400px;
      padding: 30px;
      border-radius: 24px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
      box-sizing: border-box;
    }
    h1 {
      text-align: center;
      margin-top: 0;
      font-size: 30px;
    }
    .subtitle {
      text-align: center;
      color: #777;
      margin-bottom: 28px;
    }
    label {
      display: block;
      font-weight: 600;
      margin-bottom: 8px;
      margin-top: 18px;
    }
    input {
      width: 100%;
      box-sizing: border-box;
      padding: 14px;
      border: 1px solid #ddd;
      border-radius: 12px;
      font-size: 18px;
    }
    button {
      width: 100%;
      margin-top: 24px;
      padding: 15px;
      border: none;
      border-radius: 12px;
      background: #292329;
      color: white;
      font-size: 18px;
      font-weight: 700;
      cursor: pointer;
    }
    button:active {
      transform: scale(0.98);
    }
    #result {
      display: none;
      margin-top: 25px;
      padding: 20px;
      background: #f8f3f5;
      border-radius: 16px;
      text-align: center;
    }
    .steps-left {
      color: #666;
      margin-bottom: 8px;
    }
    .time-left {
      font-size: 30px;
      font-weight: 800;
    }
    .pace {
      color: #777;
      margin-top: 8px;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <div class="calculator">
    <h1>10K Girlie 🎀</h1>
    <div class="subtitle">
      Let's see how much longer we're on this damn treadmill.
    </div>
    <label for="steps">Current steps</label>
    <input
      type="number"
      id="steps"
      placeholder="e.g. 4,372"
      min="0"
    >
    <label for="speed">Treadmill speed (mph)</label>
    <input
      type="number"
      id="speed"
      placeholder="e.g. 2.5"
      min="0.1"
      step="0.1"
    >
    <button onclick="calculate()">Calculate ✨</button>
    <div id="result">
      <div class="steps-left" id="stepsLeft"></div>
      <div class="time-left" id="timeLeft"></div>
      <div class="pace" id="pace"></div>
    </div>
  </div>
  <script>
    function calculate() {
      const TARGET_STEPS = 10000;
      // Your measured baseline:
      // 2.5 mph = 94 steps/min
      const BASE_SPEED = 2.5;
      const BASE_STEPS_PER_MIN = 94;
      const currentSteps =
        Number(document.getElementById("steps").value);
      const speed =
        Number(document.getElementById("speed").value);
      // Estimate steps/min based on your baseline
      const stepsPerMin =
        BASE_STEPS_PER_MIN * (speed / BASE_SPEED);
      const stepsLeft =
        Math.max(0, TARGET_STEPS - currentSteps);
      const totalMinutes =
        stepsLeft / stepsPerMin;
      // Convert to hours + minutes
      let hours =
        Math.floor(totalMinutes / 60);
      let minutes =
        Math.round(totalMinutes % 60);
      // Handle rounding to 60 minutes
      if (minutes === 60) {
        hours++;
        minutes = 0;
      }
      let timeText;
      if (stepsLeft === 0) {
        timeText = "YOU DID IT 🎉";
      } else if (hours > 0) {
        timeText =
          `${hours} hr ${minutes} min`;
      } else {
        timeText =
          `${minutes} min`;
      }
      document.getElementById("stepsLeft").textContent =
        stepsLeft.toLocaleString() + " steps to go";
      document.getElementById("timeLeft").textContent =
        timeText;
      document.getElementById("pace").textContent =
        "Estimated pace: " +
        Math.round(stepsPerMin) +
        " steps/min";
      document.getElementById("result").style.display =
        "block";
    }
  </script>
</body>
</html>
